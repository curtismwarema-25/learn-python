{
  "name": "fuego-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "backend": "cd ..\\.. && .\\.venv\\Scripts\\python.exe .\\fuego\\manage.py runserver 8000",
    "dev:all": "concurrently --kill-others --names backend,frontend \"npm:backend\" \"npm:dev\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "jsdom": "^27.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
